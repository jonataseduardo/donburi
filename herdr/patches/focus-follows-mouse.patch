 src/client/shell/mouse.rs                 | 18 ++++++
 src/client/shell/state.rs                 |  1 +
 src/client/shell/tests/mouse_selection.rs | 71 +++++++++++++++++++++++
 src/config/model.rs                       | 16 +++++
 src/main.rs                               |  3 +
 6 files changed, 111 insertions(+)

