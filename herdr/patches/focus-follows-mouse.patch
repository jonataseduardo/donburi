+                        if self.focused_pane_id().as_deref() != Some(hit.pane_id.as_str()) {
+                            let pane_id = hit.pane_id.clone();
+                            self.push_endpoint_method(
+                                crate::api::schema::Method::PaneFocus(
+                                    crate::api::schema::PaneTarget { pane_id },
+                                ),
+                                outcome,
+                            );
+                        }
+                    }
+                }
                 if let Some(hit) = self
                     .hits
                     .panes
