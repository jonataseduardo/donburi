index f2df294..f463568 100644
--- a/src/client/shell/mouse.rs
+++ b/src/client/shell/mouse.rs
@@ -2270,6 +2270,24 @@ impl ClientShellState {
             MouseEventKind::Up(MouseButton::Left | MouseButton::Middle)
             | MouseEventKind::Drag(MouseButton::Left | MouseButton::Middle) => {}
             MouseEventKind::Moved => {
+                if self.config.focus_follows_mouse {
+                    if let Some(hit) = self
+                        .hits
+                        .panes
+                        .iter()
+                        .find(|hit| super::contains(hit.inner_rect, point) && !hit.popup)
