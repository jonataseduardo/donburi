diff --git a/src/client/shell/tests/mouse_selection.rs b/src/client/shell/tests/mouse_selection.rs
index ae4168c..ffb1ecb 100644
--- a/src/client/shell/tests/mouse_selection.rs
+++ b/src/client/shell/tests/mouse_selection.rs
@@ -1159,3 +1159,74 @@ fn context_menu_keyboard_and_outside_click_are_client_owned() {
     assert!(outside.repaint);
     assert!(state.overlay.is_none());
 }
+
+fn focus_follows_mouse_state(enabled: bool) -> ClientShellState {
+    let mut config = Config::default();
+    config.ui.focus_follows_mouse = enabled;
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&config));
+    state.set_snapshot(Box::new(snapshot()));
+    state.set_pane_surface(surface());
+    state.compose(106, 30).expect("compose");
+    let pane = |pane_id: &str, x: u16| PaneHit {
+        rect: Rect::new(x, 1, 30, 20),
+        inner_rect: Rect::new(x + 1, 2, 28, 18),
+        scrollbar_rect: None,
+        scroll: None,
+        pane_id: pane_id.into(),
+        popup: false,
+        mouse_reporting: false,
+        sgr_pixel_mouse: false,
+        pixel_width: 0,
+        pixel_height: 0,
+    };
+    state.hits.panes = vec![pane("pane_1", 40), pane("pane_2", 72)];
+    state
+}
+
+fn hover(state: &mut ClientShellState, column: u16) -> ClientShellInput {
+    let mut input = ClientShellInput::default();
+    state.handle_mouse(
+        MouseEvent {
+            kind: MouseEventKind::Moved,
+            column,
+            row: 10,
+            modifiers: crossterm::event::KeyModifiers::NONE,
+        },
+        &mut input,
+    );
+    input
+}
+
+fn pane_focus_targets(input: &ClientShellInput) -> Vec<String> {
+    input
+        .actions
+        .iter()
+        .filter_map(|action| match action {
+            ClientShellAction::Endpoint { request, .. } => match &request.method {
+                crate::api::schema::Method::PaneFocus(target) => Some(target.pane_id.clone()),
+                _ => None,
+            },
+            _ => None,
+        })
+        .collect()
+}
+
+#[test]
+fn focus_follows_mouse_focuses_hovered_unfocused_pane() {
+    let mut state = focus_follows_mouse_state(true);
+    assert_eq!(pane_focus_targets(&hover(&mut state, 80)), vec!["pane_2"]);
+}
+
+#[test]
+fn focus_follows_mouse_ignores_hover_over_focused_pane_and_borders() {
+    let mut state = focus_follows_mouse_state(true);
+    assert!(pane_focus_targets(&hover(&mut state, 50)).is_empty());
+    // column 72 is pane_2's border, outside its inner rect
+    assert!(pane_focus_targets(&hover(&mut state, 72)).is_empty());
+}
+
+#[test]
+fn focus_follows_mouse_disabled_by_default_keeps_click_to_focus() {
+    let mut state = focus_follows_mouse_state(false);
+    assert!(pane_focus_targets(&hover(&mut state, 80)).is_empty());
+}
