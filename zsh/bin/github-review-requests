#!/usr/bin/env zsh

_github_review_requests_time_ago() {
  local iso="$1"
  local epoch now diff days hours minutes

  if [[ -z "$iso" ]]; then
    printf 'unknown'
    return
  fi

  epoch="$(date -j -f '%Y-%m-%dT%H:%M:%SZ' "$iso" '+%s' 2>/dev/null || date -d "$iso" '+%s' 2>/dev/null)"
  if [[ -z "$epoch" ]]; then
    printf 'unknown'
    return
  fi

  now="$(date '+%s')"
  diff=$((now - epoch))
  days=$((diff / 86400))
  hours=$(((diff % 86400) / 3600))
  minutes=$(((diff % 3600) / 60))

  if ((days > 0)); then
    printf '%dd %dh' "$days" "$hours"
  elif ((hours > 0)); then
    printf '%dh %dm' "$hours" "$minutes"
  else
    printf '%dm' "$minutes"
  fi
}

main() {
  local limit="${1:-30}"
  local query result viewer count pr repo_full number requested_at additions deletions changed_files branch reviewed waiting changes

  if ! command -v gh >/dev/null 2>&1; then
    printf 'gh is required for github-review-requests\n' >&2
    return 1
  fi

  if ! command -v jq >/dev/null 2>&1; then
    printf 'jq is required for github-review-requests\n' >&2
    return 1
  fi

  query='query($limit: Int!) {
    viewer { login }
    search(query: "review-requested:@me state:open type:pr", type: ISSUE, first: $limit) {
      nodes {
        ... on PullRequest {
          number
          additions
          deletions
          changedFiles
          headRefName
          repository { nameWithOwner }
          reviews(last: 100) { nodes { author { login } } }
          timelineItems(itemTypes: REVIEW_REQUESTED_EVENT, last: 100) {
            nodes {
              ... on ReviewRequestedEvent {
                createdAt
                requestedReviewer { ... on User { login } }
              }
            }
          }
        }
      }
    }
  }'

  result="$(gh api graphql -F limit="$limit" -f query="$query" 2>/dev/null)" || return
  viewer="$(jq -r '.data.viewer.login' <<< "$result")"
  count="$(jq '.data.search.nodes | length' <<< "$result")"

  if ((count == 0)); then
    printf 'No PRs are waiting for your review.\n'
    return
  fi

  printf '%-32s %-7s %-10s %-16s %-9s %s\n' 'REPOSITORY' 'PR' 'WAITING' 'CHANGES' 'REVIEWED' 'BRANCH'

  while IFS= read -r pr; do
    repo_full="$(jq -r '.repository.nameWithOwner' <<< "$pr")"
    number="$(jq -r '.number' <<< "$pr")"
    requested_at="$(jq -r --arg viewer "$viewer" '[.timelineItems.nodes[]? | select(.requestedReviewer.login == $viewer) | .createdAt] | last // empty' <<< "$pr")"
    additions="$(jq -r '.additions // 0' <<< "$pr")"
    deletions="$(jq -r '.deletions // 0' <<< "$pr")"
    changed_files="$(jq -r '.changedFiles // 0' <<< "$pr")"
    branch="$(jq -r '.headRefName // "unknown"' <<< "$pr")"
    reviewed="$(jq -r --arg viewer "$viewer" 'if ([.reviews.nodes[]? | select(.author.login == $viewer)] | length) > 0 then "yes" else "no" end' <<< "$pr")"
    waiting="$(_github_review_requests_time_ago "$requested_at")"
    changes="+$additions/-$deletions, ${changed_files}f"

    printf '%-32s #%-6s %-10s %-16s %-9s %s\n' "$repo_full" "$number" "$waiting" "$changes" "$reviewed" "$branch"
  done < <(jq -c '.data.search.nodes[]' <<< "$result")
}

main "$@"
