#!/usr/bin/env zsh

_github_review_requests_time_ago() {
  local iso="$1"
  local epoch now diff days hours minutes

  if [[ -z "$iso" ]]; then
    printf 'unknown'
    return
  fi

  epoch="$(date -j -f '%Y-%m-%dT%H:%M:%SZ' "$iso" '+%s' 2>/dev/null || date -d "$iso" '+%s' 2>/dev/null)"
  if [[ -z "$epoch" ]]; then
    printf 'unknown'
    return
  fi

  now="$(date '+%s')"
  diff=$((now - epoch))
  days=$((diff / 86400))
  hours=$(((diff % 86400) / 3600))
  minutes=$(((diff % 3600) / 60))

  if ((days > 0)); then
    printf '%dd %dh' "$days" "$hours"
  elif ((hours > 0)); then
    printf '%dh %dm' "$hours" "$minutes"
  else
    printf '%dm' "$minutes"
  fi
}

main() {
  local limit="${1:-30}"
  local viewer prs count pr host repo_full owner repo number url details timeline requested_at additions deletions changed_files branch reviewed waiting changes

  if ! command -v gh >/dev/null 2>&1; then
    printf 'gh is required for github-review-requests\n' >&2
    return 1
  fi

  if ! command -v jq >/dev/null 2>&1; then
    printf 'jq is required for github-review-requests\n' >&2
    return 1
  fi

  prs="$(gh search prs --review-requested=@me --state=open --limit "$limit" --json number,repository,url 2>/dev/null)" || return
  count="$(jq 'length' <<< "$prs")"

  if ((count == 0)); then
    printf 'No PRs are waiting for your review.\n'
    return
  fi

  printf '%-32s %-7s %-10s %-16s %-9s %s\n' 'REPOSITORY' 'PR' 'WAITING' 'CHANGES' 'REVIEWED' 'BRANCH'

  while IFS= read -r pr; do
    repo_full="$(jq -r '.repository.nameWithOwner' <<< "$pr")"
    number="$(jq -r '.number' <<< "$pr")"
    url="$(jq -r '.url' <<< "$pr")"
    host="${url#https://}"
    host="${host%%/*}"
    owner="${repo_full%%/*}"
    repo="${repo_full#*/}"

    viewer="$(gh api --hostname "$host" user --jq '.login' 2>/dev/null)"
    details="$(gh pr view "$number" --repo "$host/$repo_full" --json additions,deletions,changedFiles,headRefName,reviews 2>/dev/null)"
    timeline="$(gh api --hostname "$host" "repos/$owner/$repo/issues/$number/timeline" --paginate 2>/dev/null)"

    requested_at="$(jq -r --arg viewer "$viewer" '[.[]? | select(.event == "review_requested" and .requested_reviewer.login == $viewer) | .created_at] | last // empty' <<< "$timeline")"
    additions="$(jq -r '.additions // 0' <<< "$details")"
    deletions="$(jq -r '.deletions // 0' <<< "$details")"
    changed_files="$(jq -r '.changedFiles // 0' <<< "$details")"
    branch="$(jq -r '.headRefName // "unknown"' <<< "$details")"
    reviewed="$(jq -r --arg viewer "$viewer" 'if ([.reviews[]? | select(.author.login == $viewer)] | length) > 0 then "yes" else "no" end' <<< "$details")"
    waiting="$(_github_review_requests_time_ago "$requested_at")"
    changes="+$additions/-$deletions, ${changed_files}f"

    printf '%-32s #%-6s %-10s %-16s %-9s %s\n' "$repo_full" "$number" "$waiting" "$changes" "$reviewed" "$branch"
  done < <(jq -c '.[]' <<< "$prs")
}

main "$@"
