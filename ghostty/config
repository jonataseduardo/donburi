# Ghostty Terminal Configuration
# Simplified config - herdr handles tabs and splits inside a single Ghostty window

# Font Configuration
font-family = "JetBrains Mono"
font-size = 12

# Colors (matching your Kanagawa theme)
background = #1f1f28
foreground = #dcd7ba
cursor-color = #c8c093
selection-background = #2d4f67

# Terminal Behavior
scrollback-limit = 10000

# Start every window inside herdr (attaches to the persistent session, like tmux auto-attach)
# command = /Users/<you>/.local/bin/herdr

# Shell Integration
shell-integration = detect

# Key Bindings
# Tabs and splits live in herdr (prefix ctrl+b); Ghostty only manages windows
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+q=quit

# Copy/Paste
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# Reload configuration
keybind = ctrl+shift+r=reload_config

# Toggle fullscreen
keybind = ctrl+shift+z=toggle_fullscreen

# Shift+Enter sends escape sequence for multiline input
keybind = shift+enter=text:\x1b\r
