cmd_start() {
    echo -e "${CYAN}--- start ---${NC}"

    # AeroSpace
    if pgrep -x AeroSpace >/dev/null 2>&1; then
        log_info "AeroSpace is already running"
    else
        log_info "Starting AeroSpace..."
        open -a AeroSpace
        log_info "AeroSpace started"
    fi

    # SketchyBar
    if pgrep -x sketchybar >/dev/null 2>&1; then
        log_info "SketchyBar is already running"
    else
        log_info "Starting SketchyBar..."
        if find_brew && "$BREW_CMD" services start sketchybar 2>/dev/null | grep -q "Successfully started"; then
            log_info "SketchyBar started via brew services"
        else
            sketchybar &>/dev/null &
            log_info "SketchyBar started directly"
        fi
    fi
}

cmd_stop() {
    echo -e "${CYAN}--- stop ---${NC}"

    # AeroSpace
    if pgrep -x AeroSpace >/dev/null 2>&1; then
        log_info "Stopping AeroSpace..."
        osascript -e 'quit app "AeroSpace"' 2>/dev/null || pkill AeroSpace 2>/dev/null || true
        log_info "AeroSpace stopped"
    else
        log_info "AeroSpace is not running"
    fi

    # SketchyBar
    if pgrep -x sketchybar >/dev/null 2>&1; then
        log_info "Stopping SketchyBar..."
        pkill sketchybar 2>/dev/null || true
        log_info "SketchyBar stopped"
    else
        log_info "SketchyBar is not running"
    fi
}

# Authenticate gcalcli for the next-meeting widget. gcalcli needs your OWN Google
# Cloud OAuth "Desktop app" client (it ships none). Provide credentials via the
# GCALCLI_CLIENT_ID / GCALCLI_CLIENT_SECRET env vars, or let it prompt on the TTY.
_meeting_gcalcli_auth() {
    local uvx_bin="$1"

    if [ ! -t 0 ] && [ ! -e /dev/tty ]; then
        log_warn "No interactive terminal — run this directly to authenticate:"
        echo "  uvx gcalcli init"
        return 1
    fi

    if [ -z "${GCALCLI_CLIENT_ID:-}" ]; then
        echo ""
        echo "Google Calendar setup (one-time). gcalcli needs your own OAuth client:"
        echo "  1. Google Cloud Console → create a project"
        echo "  2. Enable the Google Calendar API for it"
        echo "  3. OAuth consent screen → External, app name 'gcalcli', add yourself as a Test user"
        echo "  4. Credentials → Create OAuth client ID → Application type: Desktop app"
        echo "  5. Copy the Client ID and Client secret"
        echo ""
        echo "Then either export GCALCLI_CLIENT_ID / GCALCLI_CLIENT_SECRET and re-run,"
        echo "or paste them at the prompts below."
        echo ""
    fi

    # Run against the controlling terminal so the secret prompt + browser flow
    # work even when invoked from a script (avoids the EOF on stdin).
    if [ -n "${GCALCLI_CLIENT_ID:-}" ] && [ -n "${GCALCLI_CLIENT_SECRET:-}" ]; then
        "$uvx_bin" gcalcli \
            --client-id="$GCALCLI_CLIENT_ID" \
            --client-secret="$GCALCLI_CLIENT_SECRET" \
            init </dev/tty >/dev/tty 2>&1
    else
        "$uvx_bin" gcalcli init </dev/tty >/dev/tty 2>&1
    fi

    if "$uvx_bin" gcalcli --nocolor agenda --tsv now now >/dev/null 2>&1; then
        log_info "gcalcli authenticated"
    else
        log_warn "gcalcli still not authenticated — widget will show 'cal?'"
        log_warn "Re-run setup any time with: donburi meeting on  (or: uvx gcalcli init)"
    fi
}

cmd_meeting() {
    local action="${1:-status}"
    local flag="${XDG_CONFIG_HOME:-$HOME/.config}/donburi/meeting-tracking"

    # Resolve uvx the same way the sketchybar plugin does (launchd-safe).
    local uvx_bin=""
    command -v uvx >/dev/null 2>&1 && uvx_bin="$(command -v uvx)"
    [ -z "$uvx_bin" ] && [ -x "$HOME/.local/bin/uvx" ] && uvx_bin="$HOME/.local/bin/uvx"

    _meeting_refresh() {
        # Re-run the widget script so it shows/hides immediately.
        if pgrep -x sketchybar >/dev/null 2>&1; then
            sketchybar --trigger routine 2>/dev/null
            sketchybar --update 2>/dev/null
        fi
    }

    case "$action" in
        on|start|enable)
            mkdir -p "$(dirname "$flag")"
            touch "$flag"
            log_info "Meeting tracking enabled"
            if [ -z "$uvx_bin" ]; then
                log_warn "uvx not found — install uv so the widget can read your calendar"
            elif ! "$uvx_bin" gcalcli --nocolor agenda --tsv now now >/dev/null 2>&1; then
                log_info "gcalcli not authenticated — starting Google Calendar setup..."
                _meeting_gcalcli_auth "$uvx_bin"
            fi
            _meeting_refresh
            ;;
        off|stop|disable)
            rm -f "$flag"
            log_info "Meeting tracking disabled (widget hidden)"
            _meeting_refresh
            ;;
        toggle)
            if [ -f "$flag" ]; then
                cmd_meeting off
            else
                cmd_meeting on
            fi
            ;;
        status)
            if [ -f "$flag" ]; then
                echo -e "${GREEN}✓${NC} Meeting tracking is ON"
            else
                echo -e "${YELLOW}⚠${NC} Meeting tracking is OFF (widget hidden)"
                echo "  Enable with: donburi meeting on"
            fi
            ;;
        *)
            log_error "Unknown meeting action: $action"
            echo "Usage: donburi meeting [on|off|toggle|status]"
            return 1
            ;;
    esac
}

cmd_reload() {
    local target="${1:-all}"
    echo -e "${CYAN}--- reload: $target ---${NC}"

    case "$target" in
        aerospace)
            if pgrep -x AeroSpace >/dev/null 2>&1; then
                log_info "Reloading AeroSpace config..."
                aerospace reload-config
                log_info "AeroSpace config reloaded"
            else
                log_warn "AeroSpace is not running — skipping"
            fi
            ;;
        sketchybar)
            if pgrep -x sketchybar >/dev/null 2>&1; then
                log_info "Reloading SketchyBar..."
                sketchybar --reload
                log_info "SketchyBar reloaded"
            else
                log_warn "SketchyBar is not running — skipping"
            fi
            ;;
        all)
            if pgrep -x AeroSpace >/dev/null 2>&1; then
                log_info "Reloading AeroSpace config..."
                aerospace reload-config
                log_info "AeroSpace config reloaded"
            else
                log_warn "AeroSpace is not running — skipping"
            fi

            if pgrep -x sketchybar >/dev/null 2>&1; then
                log_info "Reloading SketchyBar..."
                sketchybar --reload
                log_info "SketchyBar reloaded"
            else
                log_warn "SketchyBar is not running — skipping"
            fi
            ;;
        *)
            log_error "Unknown reload target: $target"
            echo "Usage: donburi reload [aerospace|sketchybar]"
            return 1
            ;;
    esac
}

